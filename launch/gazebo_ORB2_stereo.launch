<launch>

<arg name="path_slam_config" default = "/home/yipuzhao/ros_workspace/package_dir/ORB_Data/"/>
<arg name="path_track_logging" default = "/mnt/DATA/tmp/ClosedNav/debug"/>
<arg name="num_feature" default = "1600" />
<arg name="do_rectify" default = "false" />
<arg name="do_vis" default = "false" />


<!-- call baselin ORB-SLAM for vision-based state estimation  -->
<node pkg="ORB_SLAM2" type="Stereo" name="visual_slam" args="$(arg path_slam_config)/ORBvoc.txt $(arg path_slam_config)/Gazebo_yaml/pinhole_stereo.yaml $(arg num_feature) 0 0 /multisense_sl/camera/left/image_raw /multisense_sl/camera/right/image_raw $(arg path_track_logging)" output="screen">
</node>

</launch>
